                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/leads": {
      "post": {
        "tags": [
          "Website"
        ],
        "summary": "Waitlist or contact form submission from the website",
        "description": "Needs a solved ALTCHA challenge (single use). A repeat from the same phone within a day updates the earlier lead. Validation problems list fields under `errors`; a bad ALTCHA is `errors.altcha`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadAccepted"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/plans": {
      "get": {
        "tags": [
          "Website"
        ],
        "summary": "Plans on sale, in display order (pricing page)",
        "description": "Published public plans. Cached; a publish shows within a minute.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicPlan"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/demo-chat": {
      "post": {
        "tags": [
          "Website"
        ],
        "summary": "The website's live demo: one visitor message to the demo shop's AI agent",
        "description": "ALTCHA is needed on the first message of a session (400 `validation.altcha.invalid`). After `remaining` reaches 0 the answer is 429 `demo.limit`; too many messages from one IP or in a day is 429 `demo.rate_limited`; 404 `demo.unavailable` when no demo shop is configured.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoChatResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AltchaChallenge": {
        "required": [
          "algorithm",
          "challenge",
          "maxNumber",
          "salt",
          "signature"
        ],
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "challenge": {
            "type": "string"
          },
          "maxNumber": {
            "type": "integer",
            "format": "int32"
          },
          "salt": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      },
      "Currency": {
        "enum": [
          "IRR"
        ],
        "type": "string"
      },
      "DataDeletionStatusResponse": {
        "required": [
          "confirmationCode",
          "status",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "confirmationCode": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DemoChatRequest": {
        "required": [
          "sessionId",
          "message",
          "altcha"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string"
          },
          "altcha": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DemoChatResponse": {
        "required": [
          "reply",
          "confidence",
          "sources",
          "remaining",
          "handedOff"
        ],
        "type": "object",
        "properties": {
          "reply": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "format": "double"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining": {
            "type": "integer",
            "format": "int32"
          },
          "handedOff": {
            "type": "boolean"
          }
        }
      },
      "JsonElement": { },
      "LeadAccepted": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "LeadRequest": {
        "required": [
          "type",
          "phone",
          "name",
          "instagramHandle",
          "vertical",
          "monthlyDms",
          "message",
          "utm",
          "altcha"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "instagramHandle": {
            "type": [
              "null",
              "string"
            ]
          },
          "vertical": {
            "type": [
              "null",
              "string"
            ]
          },
          "monthlyDms": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "utm": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "altcha": {
            "type": [
              "null",
              "string"
            ]
          }
