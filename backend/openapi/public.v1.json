    "/api/v1/public/posts": {
      "get": {
        "tags": [
          "Website"
        ],
        "summary": "Published blog posts, newest first, without bodies",
        "description": "Filter by `category`. Paged with `cursor` (from `next`), `limit` up to 50.",
