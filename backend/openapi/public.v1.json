    "/api/v1/public/help/search": {
      "get": {
        "tags": [
          "Website"
        ],
        "summary": "Search published help articles (title, description, body and `data.keywords`)",
        "description": "Every word of `q` must match; Persian is normalised (Arabic ي/ك, digits, ZWNJ). Title matches first, at most 20.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicEntrySummary"
                  }
                }
              }
            }
          }
        }
      }
    },
