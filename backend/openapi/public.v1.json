    "/api/v1/public/preview": {
      "get": {
        "tags": [
          "Website"
        ],
        "summary": "An entry's current draft, for the site's preview mode (token from the back office)",
        "description": "Not cached. 404 when the token is invalid or expired (tokens last one hour).",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
