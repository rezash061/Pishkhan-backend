{
  "openapi": "3.1.1",
  "info": {
    "title": "Pishkhan Public API",
    "description": "Contract owned by the backend (overview section 6). Errors are RFC 9457 Problem Details whose `errors` hold message keys.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/public/altcha/challenge": {
      "get": {
        "tags": [
          "Bot protection"
        ],
        "summary": "ALTCHA proof-of-work challenge for sign-up and forms",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AltchaChallenge"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/meta/instagram/data-deletion/{code}": {
      "get": {
        "tags": [
          "Meta callbacks"
        ],
        "summary": "Status of a Meta data deletion request",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataDeletionStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/leads": {
      "post": {
        "tags": [
          "Website"
        ],
        "summary": "Waitlist or contact form submission from the website",
        "description": "Needs a solved ALTCHA challenge (single use). A repeat from the same phone within a day updates the earlier lead. Validation problems list fields under `errors`; a bad ALTCHA is `errors.altcha`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadAccepted"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/plans": {
      "get": {
        "tags": [
          "Website"
        ],
        "summary": "Plans on sale, in display order (pricing page)",
        "description": "Published public plans. Cached; a publish shows within a minute.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicPlan"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AltchaChallenge": {
        "required": [
          "algorithm",
          "challenge",
          "maxNumber",
          "salt",
          "signature"
        ],
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "challenge": {
            "type": "string"
          },
          "maxNumber": {
            "type": "integer",
            "format": "int32"
          },
          "salt": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      },
      "Currency": {
        "enum": [
          "IRR"
        ],
        "type": "string"
      },
      "DataDeletionStatusResponse": {
        "required": [
          "confirmationCode",
          "status",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "confirmationCode": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LeadAccepted": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "LeadRequest": {
        "required": [
          "type",
          "phone",
          "name",
          "instagramHandle",
          "vertical",
          "monthlyDms",
          "message",
          "utm",
          "altcha"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "instagramHandle": {
            "type": [
              "null",
              "string"
            ]
          },
          "vertical": {
            "type": [
              "null",
              "string"
            ]
          },
          "monthlyDms": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "utm": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "altcha": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Money": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        }
      },
      "PlanFeature": {
        "required": [
          "key",
          "label",
          "included",
          "limit"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "included": {
            "type": "boolean"
          },
          "limit": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PublicPlan": {
        "required": [
          "code",
          "name",
          "tagline",
          "description",
          "monthly",
          "annual",
          "aiConversations",
          "overagePerConversation",
          "channelAccounts",
          "seats",
          "highlighted",
          "isFree",
          "limits",
          "features"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tagline": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "monthly": {
            "$ref": "#/components/schemas/Money"
          },
          "annual": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Money"
              }
            ]
          },
          "aiConversations": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "overagePerConversation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Money"
              }
            ]
          },
          "channelAccounts": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "seats": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "highlighted": {
            "type": "boolean"
          },
          "isFree": {
            "type": "boolean"
          },
          "limits": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "null",
                "integer"
              ],
              "format": "int32"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanFeature"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Bot protection"
    },
    {
      "name": "Meta callbacks"
    },
    {
      "name": "Website"
    }
  ]
}