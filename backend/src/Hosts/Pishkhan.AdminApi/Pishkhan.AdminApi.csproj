<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Build-time OpenAPI export (checked for drift in CI). -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name pishkhan</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Content\Pishkhan.Modules.Content\Pishkhan.Modules.Content.csproj" />
    <ProjectReference Include="..\..\Modules\Backoffice\Pishkhan.Modules.Backoffice\Pishkhan.Modules.Backoffice.csproj" />
  </ItemGroup>
</Project>
